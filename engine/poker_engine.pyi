def make_infoset_key(street: int, bucket: int, sequence: Sequence[int]) -> int: ...
def decode_infoset_key(key: int) -> tuple[int, int, list[int]]: ...
def action_from(kind: int, amount: int) -> Action: ...

class ActionAbstraction:
    streets: list[list[AbstractActionSpec]]
    max_raises: int
    def __init__(self, streets: object | None = None, max_raises: int = 4) -> None: ...
    def legal(self, state: GameState) -> list[tuple[int, Action]]: ...
    def to_concrete(self, state: GameState, index: int) -> Action | None: ...
    def translate(
        self, abs_state: GameState, real_state: GameState, action: Action, u: float = 0.5
    ) -> int | None: ...
    def sequence(self, state: GameState) -> list[int]: ...
    def count_tree(self, config: GameConfig | dict, limit: int = ...) -> list[int] | None: ...
    @staticmethod
    def pot_fraction(state: GameState, raise_to: int) -> float: ...

class CardAbstraction:
    def __init__(
        self,
        buckets: Sequence[int] | None = None,
        hs_samples: int = 256,
        tables: Sequence[str | npt.NDArray[np.integer] | None] | None = None,
    ) -> None: ...
    def bucket(self, street: int, hole: Sequence[int], board: Sequence[int]) -> int: ...
    def buckets_batch(
        self, street: int, cards: npt.NDArray[np.uint8]
    ) -> npt.NDArray[np.uint32]: ...
    def num_buckets(self, street: int) -> int: ...

class Trainer:
    iterations: int
    config_json: str
    meta: str
    game_config: GameConfig
    def __init__(self, config: dict | None = None) -> None: ...
    def run(self, iterations: int, threads: int = 1) -> dict: ...
    def stats(self, detailed: bool = False) -> dict: ...
    def set_checkpoint(self, path: str | None, interval_seconds: float) -> None: ...
    def action_abstraction(self) -> ActionAbstraction: ...
    def bucket(self, street: int, hole: Sequence[int], board: Sequence[int]) -> int: ...
    def save(self, path: str) -> None: ...
    @staticmethod
    def load(path: str) -> Trainer: ...
    def export_strategy(self, path: str) -> int: ...
    def strategy(self, state: GameState, player: int, average: bool = True) -> list[float]: ...
    def infoset_key(self, state: GameState, player: int) -> int: ...
    def lookup(self, key: int) -> tuple[list[float], list[float]] | None: ...
    def entries(self) -> list[tuple[int, list[float], list[float]]]: ...

class BlueprintStrategy:
    config_json: str
    meta: str
    game_config: GameConfig
    def __init__(self, path: str) -> None: ...
    def __len__(self) -> int: ...
    def action_abstraction(self) -> ActionAbstraction: ...
    def bucket(self, street: int, hole: Sequence[int], board: Sequence[int]) -> int: ...
    def lookup(self, key: int) -> list[float] | None: ...
    def action_probs(
        self, abs_state: GameState, hole: Sequence[int], board: Sequence[int]
    ) -> tuple[list[int], list[Action], list[float], bool]: ...
